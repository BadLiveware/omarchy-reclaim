[Unit]
Description=Reclaim disk space when free space is low

[Service]
Type=oneshot
ExecStart=%h/.local/bin/reclaim run --only-if-low-disk
Environment=DOCKER_HOST=unix://%t/docker.sock
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h %t
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
